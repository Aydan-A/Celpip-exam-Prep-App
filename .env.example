# Optional. When set, writing/speaking feedback is scored by Claude.
# Without it, the app falls back to a built-in heuristic scorer so it still works offline.
ANTHROPIC_API_KEY=

# Model used for AI scoring (defaults to claude-opus-4-8).
CELPIP_MODEL=claude-opus-4-8

# Port for the production server (npm run start).
PORT=3000
